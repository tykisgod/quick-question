version: 1

default_profile: feature
# Built-in profiles: lightweight, core, feature (default), hardening.
# A custom profile needs a new name. One named like a built-in replaces it outright instead of
# extending it, and loses every pack it does not list. To customize, extend a built-in:
#   profiles:
#     my-feature:
#       extends: feature
#       add_packs:
#         - workflow-docs
# then set default_profile: my-feature

enabled_rules:
  - find_object_of_type
  - send_message
  - tag_compare
  - get_component_in_hot_path

trust_level: trusted

# workflow: how heavy the process is.
#   heavy-review   - Heavy Review (default): design / plan / code review loops, each finding verified
#                    by a subagent behind the review gate.
#   prototype-loop - Prototype Loop: the user approves a numbered acceptance checklist, every slice starts
#                    with a failing check, code is reviewed once, an independent agent checks the checklist
#                    at the end. Turns the review_gate hook off. Not the same as work_mode: prototype.
# A personal preference belongs in .qq/local.yaml, so teammates keep their own.
workflow: heavy-review

# install controls the physical project-local runtime footprint.
# Use the onboarding wizard or install.sh --preset if you want simpler defaults.
install:
  hosts:
    - claude
    - codex
    - mcp
  add_modules: []
  remove_modules: []
  sync: false
